<Window x:Class="IPAToolGUI.Views.TwoFactorAuthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apple ID 双重认证" 
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}"
        Background="#FFFFFF"
        FocusManager.FocusedElement="{Binding ElementName=CodeTextBox}">
    
    <Border Padding="24" Background="#FFFFFF">
        <StackPanel>
            <!-- Header Icon & Title -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="36" Height="36" CornerRadius="18" Background="#EFF6FF" Margin="0,0,12,0">
                    <TextBlock Text="🔐" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="双重认证验证" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Two-Factor Authentication" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Description -->
            <TextBlock Text="已向你的受信任 Apple 设备发送了验证码。请输入接收到的 6 位验证码以继续登录：" 
                       TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" LineHeight="18"/>

            <!-- 2FA Code Input Box -->
            <TextBox x:Name="CodeTextBox" 
                     Height="46" FontSize="22" FontWeight="Bold"
                     TextAlignment="Center" VerticalContentAlignment="Center"
                     MaxLength="6" Margin="0,0,0,20"
                     BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2"
                     KeyDown="CodeTextBox_KeyDown"
                     TextChanged="CodeTextBox_TextChanged"/>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="取消" Style="{StaticResource SecondaryButtonStyle}" 
                        Height="36" Click="CancelButton_Click"/>

                <Button Grid.Column="2" x:Name="ConfirmButton" Content="提 交 验 证" Style="{StaticResource PrimaryButtonStyle}" 
                        Height="36" Click="ConfirmButton_Click" IsEnabled="False"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
