<Window x:Class="IPAToolGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:IPAToolGUI.ViewModels"
        mc:Ignorable="d"
        Title="IPATool GUI - 苹果旧版应用与IPA下载管理工具" 
        Height="780" Width="1080"
        MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}"
        Cursor="Arrow">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area (Tabs) -->
            <RowDefinition Height="*" />
            <!-- Splitter -->
            <RowDefinition Height="Auto" />
            <!-- Bottom Console / Status -->
            <RowDefinition Height="180" MinHeight="100" MaxHeight="400" />
        </Grid.RowDefinitions>

        <!-- 1. Top Header Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🍎 IPATool GUI" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border Background="#E0F2FE" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="v2.5.0 Support" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1" />
                    </Border>
                    <TextBlock Text="— 苹果 App Store 官方正版 / 历史旧版 IPA 下载" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Header Right: Proxy & Account Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Proxy Quick Toggle -->
                    <Border Background="#F9FAFB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="10,4" Margin="0,0,10,0" ToolTip="全局网络代理设置">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding SettingEnableProxy}" Content="代理" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding SettingProxyUrl}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- Current Account Status Badge -->
                    <Border Background="#F9FAFB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding AccountName}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding AccountEmail, StringFormat='({0})'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Button Content="刷新状态" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshAccountCommand}" Padding="8,4" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Content Tabs -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Margin="16,12,16,6">
            
            <!-- TAB 1: 账号管理 -->
            <TabItem Header="👤 账号管理">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Account Details -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="当前登录状态" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                                
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="账号名称:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AccountName}" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Apple ID:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AccountEmail}" FontWeight="SemiBold"/>
                                </Grid>

                                <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,16">
                                    <TextBlock Text="💡 提示：IPATool 使用你自己的 Apple ID 官方凭据直接从苹果 App Store 服务器下载正版 IPA，下载的文件自带你的个人授权，装入设备不会闪退。" TextWrapping="Wrap" FontSize="12" Foreground="#92400E"/>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="退出登录 (Revoke)" Style="{StaticResource DangerButtonStyle}" Command="{Binding RevokeCommand}" Margin="0,0,10,0"/>
                                    <Button Content="清空本地密钥库缓存" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearKeychainCacheCommand}" ToolTip="删除 ~/.ipatool 目录，解决密码校验失败问题"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Right: Login Form -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="登录 Apple ID" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

                                <TextBlock Text="Apple ID 邮箱:" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding LoginEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Height="34"/>

                                <TextBlock Text="Apple ID 密码:" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding LoginPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" Height="34">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>

                                <Border Background="#F3F4F6" CornerRadius="4" Padding="10,8" Margin="0,0,0,18">
                                    <TextBlock Text="🔒 验证说明：点击登录后，若你的 Apple ID 开启了双重认证（2FA），界面会自动弹出验证码输入弹窗，在手机上确认后输入 6 位验证码即可完成登录。" 
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="17"/>
                                </Border>

                                <Button Content="登 录 Apple ID" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding LoginCommand}" Height="38" FontSize="14"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: 搜索应用 -->
            <TabItem Header="🔍 搜索应用">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search Input Toolbar -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" Height="34" FontSize="14" VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="平台:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox SelectedValue="{Binding SearchPlatform}" SelectedValuePath="Tag" Width="90" Height="32" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="iPhone" Tag="iphone" IsSelected="True" />
                                    <ComboBoxItem Content="iPad" Tag="ipad" />
                                    <ComboBoxItem Content="Apple TV" Tag="appletv" />
                                    <ComboBoxItem Content="VisionOS" Tag="visionos" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="数量:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox SelectedValue="{Binding SearchLimit}" SelectedValuePath="Content" Width="65" Height="32" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="5" />
                                    <ComboBoxItem Content="10" IsSelected="True" />
                                    <ComboBoxItem Content="20" />
                                    <ComboBoxItem Content="50" />
                                </ComboBox>
                            </StackPanel>

                            <Button Grid.Column="3" Content="搜 索" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchCommand}" Width="80" Height="34"/>
                        </Grid>
                    </Border>

                    <!-- Search Results Table -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchApp}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="应用名称" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Bundle Identifier" Binding="{Binding BundleId}" Width="2*" />
                            <DataGridTextColumn Header="App ID" Binding="{Binding Id}" Width="120" />
                            <DataGridTextColumn Header="最新版本" Binding="{Binding Version}" Width="90" />
                            <DataGridTextColumn Header="价格" Binding="{Binding DisplayPrice}" Width="80" />
                            <DataGridTemplateColumn Header="操作" Width="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="历史版本" Style="{StaticResource PrimaryButtonStyle}" 
                                                    Command="{Binding DataContext.ViewVersionsFromSearchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding}" Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                                            <Button Content="直接下载" Style="{StaticResource SecondaryButtonStyle}" 
                                                    Command="{Binding DataContext.DownloadFromSearchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding}" Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                                            <Button Content="获取许可" Style="{StaticResource SecondaryButtonStyle}" 
                                                    Command="{Binding DataContext.PurchaseFromSearchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    Padding="8,3" FontSize="11" ToolTip="免费应用先获取购买授权"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 3: 历史版本查询与下载 -->
            <TabItem Header="📜 历史版本">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Target App & Query Toolbar -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="目标 Bundle ID:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding VersionTargetBundleId, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,0,10,0" ToolTip="例如: com.alipay.iphoneclient 或 com.tencent.xin"/>

                            <Button Grid.Row="0" Grid.Column="2" Content="获取历史版本列表" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ListVersionsCommand}" Height="32" Margin="0,0,10,0"/>
                            <Button Grid.Row="0" Grid.Column="3" Content="批量查询前30个版本号" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BatchQueryMetadataCommand}" Height="32"/>

                            <!-- Filter Box -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                <TextBlock Text="筛选版本 (输入版本号如 10.2.96 或构建 ID):" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding FilterVersionText, UpdateSourceTrigger=PropertyChanged}" Width="250" Height="28" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding VersionItems.Count, StringFormat='共 {0} 个版本记录'}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Versions DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding VersionItems}" SelectedItem="{Binding SelectedVersionItem}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="构建 ID (External Version ID)" Binding="{Binding VersionId}" Width="2*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="对应版本号 (Display Version)" Binding="{Binding DisplayVersion}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="未查询">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                <Setter Property="FontStyle" Value="Italic" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="发布日期" Binding="{Binding ReleaseDate}" Width="160" />
                            <DataGridTemplateColumn Header="操作" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="查询版本号" Style="{StaticResource SecondaryButtonStyle}" 
                                                    Command="{Binding DataContext.QuerySelectedVersionMetadataCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                                            <Button Content="一键下载此版本" Style="{StaticResource PrimaryButtonStyle}" 
                                                    Command="{Binding DataContext.DownloadSelectedVersionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding}" Padding="8,3" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 4: 下载中心 -->
            <TabItem Header="⬇️ 下载中心">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="IPA 下载设置" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                            <!-- Bundle ID -->
                            <TextBlock Text="Bundle Identifier (应用包名):" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding DownloadBundleId, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,0,12"/>

                            <!-- App ID -->
                            <TextBlock Text="App ID (可选，若已填写 Bundle ID 可留空):" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding DownloadAppId, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,0,12"/>

                            <!-- External Version ID -->
                            <TextBlock Text="历史版本构建 ID (External Version ID，留空下载最新版):" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding DownloadExternalVersionId, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,0,6"/>
                            <TextBlock Text="* 如需下载特定旧版本（如支付宝 10.2.96），在此填入对应历史构建 ID（如 852xxxxxx）" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                            <!-- Platform -->
                            <TextBlock Text="目标平台:" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox SelectedValue="{Binding DownloadPlatform}" SelectedValuePath="Tag" Height="34" Margin="0,0,0,12">
                                <ComboBoxItem Content="iPhone (iOS)" Tag="iphone" IsSelected="True"/>
                                <ComboBoxItem Content="iPad (iPadOS)" Tag="ipad"/>
                                <ComboBoxItem Content="Apple TV (tvOS)" Tag="appletv"/>
                                <ComboBoxItem Content="VisionOS" Tag="visionos"/>
                            </ComboBox>

                            <!-- Output Directory -->
                            <TextBlock Text="保存保存目录:" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding DownloadOutputDir, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="浏览..." Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectOutputDirCommand}" Height="34" Padding="14,0"/>
                            </Grid>

                            <!-- Options -->
                            <CheckBox IsChecked="{Binding AutoPurchaseLicense}" Content="若未获取该应用，自动获取免费购买凭据 (--purchase)" Margin="0,0,0,20" VerticalContentAlignment="Center"/>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Content="🚀 开始下载 IPA 包" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartDownloadCommand}" Height="40" Padding="24,0" FontSize="15" Margin="0,0,12,0"/>
                                <Button Content="📁 打开下载目录" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenDownloadDirCommand}" Height="40" Padding="16,0"/>
                            </StackPanel>

                            <!-- Last Downloaded info -->
                            <Border Background="#F3F4F6" CornerRadius="4" Padding="12" Visibility="{Binding LastDownloadedFile, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel>
                                    <TextBlock Text="最近下载完成文件：" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding LastDownloadedFile}" TextWrapping="Wrap" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: 已购应用 -->
            <TabItem Header="📦 已购应用">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar & Pagination -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Content="刷新已购列表" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RefreshPurchasesCommand}" Height="32"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="上一页" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PrevPurchasesPageCommand}" Height="30" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding PurchasedPage, StringFormat='第 {0} 页'}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding PurchasedTotalCount, StringFormat='(共 {0} 个应用)'}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                <Button Content="下一页" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding NextPurchasesPageCommand}" Height="30"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Table -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding PurchasedApps}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="应用名称" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Bundle Identifier" Binding="{Binding BundleId}" Width="2*"/>
                            <DataGridTextColumn Header="App ID" Binding="{Binding Id}" Width="120"/>
                            <DataGridTextColumn Header="购买/获取时间" Binding="{Binding PurchaseDate}" Width="160"/>
                            <DataGridTemplateColumn Header="操作" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="历史版本" Style="{StaticResource PrimaryButtonStyle}" 
                                                    Command="{Binding DataContext.ViewVersionsFromSearchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding}" Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                                            <Button Content="直接下载" Style="{StaticResource SecondaryButtonStyle}" 
                                                    Command="{Binding DataContext.DownloadFromSearchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding}" Padding="8,3" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 6: 设置 -->
            <TabItem Header="⚙️ 设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                            <TextBlock Text="全局参数与配置" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                            <!-- ipatool engine status -->
                            <TextBlock Text="内置 ipatool 引擎状态:" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Border Background="#F9FAFB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="已自动加载程序同目录下的 ipatool.exe" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ResolvedIpaToolPath}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Text="引擎就绪" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Network Proxy -->
                            <TextBlock Text="网络代理配置 (HTTP / SOCKS5):" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding SettingEnableProxy}" Content="启用网络代理 (通过环境变量传递给 ipatool 进程)" FontWeight="SemiBold" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="代理地址 (例如 http://127.0.0.1:10808):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SettingProxyUrl, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,8,0" IsEnabled="{Binding SettingEnableProxy}"/>
                                        <Button Grid.Column="1" Content="测试代理连接" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding TestProxyCommand}" Height="34" Padding="14,0" IsEnabled="{Binding SettingEnableProxy}"/>
                                    </Grid>
                                    <TextBlock Text="* 国内访问 Apple App Store 认证接口通常需要代理，支持 Clash / v2rayN 等常见本地代理端口。" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Keychain Passphrase -->
                            <TextBlock Text="本地密钥库解锁密码 (--keychain-passphrase):" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding SettingKeychainPassphrase, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,6,0"/>
                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,14">
                                <TextBlock Text="✅ 核心功能说明：设置此密码后，IPATool 将自动在所有操作（搜索、版本查询、下载等）中以命令行参数传入此密码，彻底规避 Windows 终端下无法输入密码和直接卡死报错的 Bug！" TextWrapping="Wrap" FontSize="12" Foreground="#065F46"/>
                            </Border>

                            <!-- Default Output Dir -->
                            <TextBlock Text="默认 IPA 下载保存目录:" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SettingDownloadDir, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="浏览..." Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseSettingDownloadDirCommand}" Height="34" Padding="14,0"/>
                            </Grid>

                            <!-- Default Platform -->
                            <TextBlock Text="默认下载平台:" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox SelectedValue="{Binding SettingPlatform}" SelectedValuePath="Tag" Height="34" Margin="0,0,0,20">
                                <ComboBoxItem Content="iPhone (iOS)" Tag="iphone" IsSelected="True"/>
                                <ComboBoxItem Content="iPad (iPadOS)" Tag="ipad"/>
                                <ComboBoxItem Content="Apple TV (tvOS)" Tag="appletv"/>
                                <ComboBoxItem Content="VisionOS" Tag="visionos"/>
                            </ComboBox>

                            <Button Content="💾 保存并应用设置" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveSettingsCommand}" Height="38" Padding="20,0" FontSize="14"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 3. GridSplitter -->
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{StaticResource BorderBrush}" Cursor="SizeNS"/>

        <!-- 4. Bottom Real-time Logs & Status Bar -->
        <Grid Grid.Row="3" Background="#1E1E1E">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Status Header -->
            <Border Grid.Row="0" Background="#252526" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="14,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar Width="14" Height="14" IsIndeterminate="True" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"/>
                        <TextBlock Text="状态: " Foreground="#858585" FontSize="12" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="取消当前操作" Style="{StaticResource DangerButtonStyle}" Command="{Binding CancelCommand}" 
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" Padding="8,2" FontSize="11" Margin="0,0,8,0"/>
                        <Button Content="清空日志" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearLogsCommand}" 
                                Background="#333333" Foreground="#CCCCCC" BorderThickness="0" Padding="8,2" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Terminal Output TextBox -->
            <TextBox Grid.Row="1" Text="{Binding Logs, Mode=OneWay}" 
                     Background="#1E1E1E" Foreground="#D4D4D4" 
                     FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"
                     IsReadOnly="True" TextWrapping="Wrap" 
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Padding="10" BorderThickness="0"
                     TextChanged="LogsTextBox_TextChanged"/>
        </Grid>
    </Grid>
</Window>
